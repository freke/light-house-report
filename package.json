{
  "name": "lighthouse-runner",
  "version": "1.0.0",
  "description": "Automated Lighthouse performance auditing with visual dashboard",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "lighthouse-runner.mjs",
  "type": "module",
  "bin": {
    "lighthouse-runner": "./lighthouse-runner.mjs"
  },
  "files": [
    "lighthouse-runner.mjs",
    "lighthouse-runner.mjs.map",
    "README.md"
  ],
  "scripts": {
    "build": "node build.js",
    "build:watch": "node build.js --watch",
    "build:minify": "node build.js --minify",
    "start": "node lighthouse-runner.mjs",
    "dev": "npm run build && npm run start",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf lighthouse-runner.mjs lighthouse-runner.mjs.map",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "lighthouse",
    "performance",
    "auditing",
    "dashboard"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "archiver": "^7.0.1",
    "chrome-launcher": "^1.2.1",
    "exceljs": "^4.4.0",
    "lighthouse": "^13.4.1"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "rimraf": "^5.0.5",
    "typescript": "^5.3.0"
  }
}
